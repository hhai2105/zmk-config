#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &dactyl_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";

	col-gpios
	= 
	  <&gpio0 31 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio0 29 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio1 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio1 13 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio1 11 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio0 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio0 17 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
	, <&gpio0 20 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
    ;

    row-gpios
	= <&gpio0 22 GPIO_ACTIVE_HIGH>
	, <&gpio0 24 GPIO_ACTIVE_HIGH>
	, <&gpio1 0 GPIO_ACTIVE_HIGH>
	, <&gpio0 11 GPIO_ACTIVE_HIGH>
	, <&gpio1 4 GPIO_ACTIVE_HIGH>
    ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <5>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)     RC(0,15) RC(0,14) RC(0,13) RC(0,12) RC(0,11) RC(0,10) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)     RC(1,15) RC(1,14) RC(1,13) RC(1,12) RC(1,11) RC(1,10) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)     RC(2,15) RC(2,14) RC(2,13) RC(2,12) RC(2,11) RC(2,10) RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3)                                                        RC(3,12) RC(3,11) RC(3,10) RC(3,9)
                                RC(3,4) RC(3,5)                      RC(3,14) RC(3,13)
                                        RC(3,7) RC(3,8)     RC(3,17) RC(3,16)
                                        RC(4,7) RC(4,8)     RC(4,17) RC(4,16)
        >;
    };

    dactyl_layout: dactyl_layout {
        compatible = "zmk,physical-layout";
        display-name = "Dactyl Mini Plus";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        // Positions are in centi-keyunits (100 = 1u), in the same order as
        // default_transform's map: 3 full finger rows (col 6 is the extra
        // key next to T/G/B), a 4-key bottom finger row, and a 6-key thumb
        // cluster per half as three pairs.
        keys
            // row 0
            = <&key_physical_attrs 100 100     0    35       0     0     0>
            , <&key_physical_attrs 100 100   100    35       0     0     0>
            , <&key_physical_attrs 100 100   200    10       0     0     0>
            , <&key_physical_attrs 100 100   300     0       0     0     0>
            , <&key_physical_attrs 100 100   400    10       0     0     0>
            , <&key_physical_attrs 100 100   500    35       0     0     0>
            , <&key_physical_attrs 100 100   600    45       0     0     0>
            , <&key_physical_attrs 100 100  1200    45       0     0     0>
            , <&key_physical_attrs 100 100  1300    35       0     0     0>
            , <&key_physical_attrs 100 100  1400    10       0     0     0>
            , <&key_physical_attrs 100 100  1500     0       0     0     0>
            , <&key_physical_attrs 100 100  1600    10       0     0     0>
            , <&key_physical_attrs 100 100  1700    35       0     0     0>
            , <&key_physical_attrs 100 100  1800    35       0     0     0>

            // row 1
            , <&key_physical_attrs 100 100     0   135       0     0     0>
            , <&key_physical_attrs 100 100   100   135       0     0     0>
            , <&key_physical_attrs 100 100   200   110       0     0     0>
            , <&key_physical_attrs 100 100   300   100       0     0     0>
            , <&key_physical_attrs 100 100   400   110       0     0     0>
            , <&key_physical_attrs 100 100   500   135       0     0     0>
            , <&key_physical_attrs 100 100   600   145       0     0     0>
            , <&key_physical_attrs 100 100  1200   145       0     0     0>
            , <&key_physical_attrs 100 100  1300   135       0     0     0>
            , <&key_physical_attrs 100 100  1400   110       0     0     0>
            , <&key_physical_attrs 100 100  1500   100       0     0     0>
            , <&key_physical_attrs 100 100  1600   110       0     0     0>
            , <&key_physical_attrs 100 100  1700   135       0     0     0>
            , <&key_physical_attrs 100 100  1800   135       0     0     0>

            // row 2
            , <&key_physical_attrs 100 100     0   235       0     0     0>
            , <&key_physical_attrs 100 100   100   235       0     0     0>
            , <&key_physical_attrs 100 100   200   210       0     0     0>
            , <&key_physical_attrs 100 100   300   200       0     0     0>
            , <&key_physical_attrs 100 100   400   210       0     0     0>
            , <&key_physical_attrs 100 100   500   235       0     0     0>
            , <&key_physical_attrs 100 100   600   245       0     0     0>
            , <&key_physical_attrs 100 100  1200   245       0     0     0>
            , <&key_physical_attrs 100 100  1300   235       0     0     0>
            , <&key_physical_attrs 100 100  1400   210       0     0     0>
            , <&key_physical_attrs 100 100  1500   200       0     0     0>
            , <&key_physical_attrs 100 100  1600   210       0     0     0>
            , <&key_physical_attrs 100 100  1700   235       0     0     0>
            , <&key_physical_attrs 100 100  1800   235       0     0     0>

            // row 3 (fingers)
            , <&key_physical_attrs 100 100     0   335       0     0     0>
            , <&key_physical_attrs 100 100   100   335       0     0     0>
            , <&key_physical_attrs 100 100   200   310       0     0     0>
            , <&key_physical_attrs 100 100   300   300       0     0     0>
            , <&key_physical_attrs 100 100  1500   300       0     0     0>
            , <&key_physical_attrs 100 100  1600   310       0     0     0>
            , <&key_physical_attrs 100 100  1700   335       0     0     0>
            , <&key_physical_attrs 100 100  1800   335       0     0     0>

            // thumb cluster: upper pair
            , <&key_physical_attrs 100 100   400   330    1500   500   400>
            , <&key_physical_attrs 100 100   500   330    1500   500   400>
            , <&key_physical_attrs 100 100  1300   330 (-1500)  1400   400>
            , <&key_physical_attrs 100 100  1400   330 (-1500)  1400   400>

            // thumb cluster: middle pair
            , <&key_physical_attrs 100 100   450   430    1500   500   400>
            , <&key_physical_attrs 100 100   550   430    1500   500   400>
            , <&key_physical_attrs 100 100  1250   430 (-1500)  1400   400>
            , <&key_physical_attrs 100 100  1350   430 (-1500)  1400   400>

            // thumb cluster: lower pair
            , <&key_physical_attrs 100 100   500   530    1500   500   400>
            , <&key_physical_attrs 100 100   600   530    1500   500   400>
            , <&key_physical_attrs 100 100  1200   530 (-1500)  1400   400>
            , <&key_physical_attrs 100 100  1300   530 (-1500)  1400   400>
            ;
    };

};
