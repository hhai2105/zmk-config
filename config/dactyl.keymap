#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  F1 |  F2 |  F3 |  F4 |  F5 | VOLUP |      |    | MUTE |  F6  |  F7 |  F8 |  F9 | F10  | PSCRN |
            // |  ~   |  1  |  2  |  3  |  4  |  5  | VOLDN |      |    |  -   |  6   |  7  |  8  |  9  |  0   | +     |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  | PgUp  |      |    |  {   |  Y   |  U  |  I  |  O  |  P   | \     |
            // | CAP  |  A  |  S  |  D  |  F  |  G  | PgDn  |      |    |  }   |  H   |  J  |  K  |  L  |  ;   | '     |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |       |      |    |      |  N   |  M  |  ,  |  .  |  /   | HOME  |
            // | L2   |  \  |  <- |  v  | BKSP| SHFT| ALT   | L1   |    |      |  M   |  ,  |  .  |  /  | ESC  | END |
            //                                      | CTRL  | META |    |    | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5     &kp C_VOL_UP            &kp C_MUTE  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10  &kp PSCRN
&kp TILDE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5     &kp C_VOL_DN                                   &kp MINUS  &kp N6     &kp N7     &kp N8   &kp N9     &kp N0    &kp PLUS
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T      &kp PG_UP                                      &kp LBKT   &kp Y      &kp U      &kp I    &kp O      &kp P     &kp BSLH
&kp CLCK   &kp A     &kp S     &kp D     &kp F     &kp G      &kp PG_DN                                      &kp RBKT   &kp H      &kp J      &kp K    &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B                                                                           &kp N      &kp M    &kp COMMA  &kp DOT   &kp FSLH  &kp HOME
&mo 2      &kp BSLH  &kp LEFT  &kp DOWN  &kp BSPC  &kp LSHFT  &kp LALT      &mo 1                 &kp ENTER  &kp RALT   &kp RSHFT  &kp SPACE  &kp UP   &kp RIGHT  &kp ESC   &kp END
                                                              &kp LCTRL     &kp LGUI                         &kp RGUI   &kp RCTRL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bootloader  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5     &kp C_VOL_UP            &kp C_MUTE  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10  &bootloader
&kp TILDE    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5     &kp C_VOL_DN                                   &kp MINUS  &kp N6     &kp N7     &kp N8   &kp N9       &kp N0    &kp PLUS
&kp TAB      &kp Q     &kp W     &kp E     &kp R     &kp T      &kp PG_UP                                      &kp LBKT   &kp Y      &kp U      &kp I    &kp O        &kp P     &kp BSLH
&kp CLCK     &kp A     &kp S     &kp D     &kp F     &kp G      &kp PG_DN                                      &kp RBKT   &kp H      &kp J      &kp K    &kp L        &kp SEMI  &kp SQT
&kp LSHFT    &kp Z     &kp X     &kp C     &kp V     &kp B                                                                           &kp N      &kp M    &kp COMMA    &kp DOT   &kp FSLH  &kp HOME
&mo 2        &kp BSLH  &kp LEFT  &kp DOWN  &kp BSPC  &kp LSHFT  &kp LALT      &mo 1                 &kp ENTER  &kp RALT   &kp RSHFT  &kp SPACE  &kp UP   &kp RIGHT    &kp ESC   &kp END
                                                                &kp LCTRL     &kp LGUI                         &kp RGUI   &kp RCTRL
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bootloader  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp C_VOL_UP            &kp C_MUTE  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10  &bootloader
&trans       &trans        &kp N2        &kp N3        &kp N4        &kp N5        &kp C_VOL_DN                                   &kp MINUS  &kp N6     &kp N7     &kp N8   &kp N9       &kp N0    &kp PLUS
&trans       &trans        &trans        &trans        &trans        &trans        &trans                                         &kp LBKT   &kp Y      &kp U      &kp I    &kp O        &kp P     &kp BSLH
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                         &kp RBKT   &kp H      &kp J      &kp K    &kp L        &kp SEMI  &kp SQT
&kp LSHFT    &kp Z         &kp X         &kp C         &kp V         &kp B                                                                              &kp N      &kp M    &kp COMMA    &kp DOT   &kp FSLH  &kp HOME
&mo 2        &kp BSLH      &kp LEFT      &kp DOWN      &kp BSPC      &kp LSHFT     &kp LALT      &mo 1                 &kp ENTER  &kp RALT   &kp RSHFT  &kp SPACE  &kp UP   &kp RIGHT    &kp ESC   &kp END
                                                                                   &kp LCTRL     &kp LGUI                         &kp RGUI   &kp RCTRL
            >;
        };
    };
};
