#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define U_MOUSE_MOVE_MED 600
#define U_MOUSE_MOVE_MAX 1000
#define U_MOUSE_MOVE_MIN 300

#undef MOVE_UP
#undef MOVE_DOWN
#undef MOVE_LEFT
#undef MOVE_RIGHT

#define MOVE_UP_MED MOVE_Y(-U_MOUSE_MOVE_MED)
#define MOVE_DOWN_MED MOVE_Y(U_MOUSE_MOVE_MED)
#define MOVE_LEFT_MED MOVE_X(-U_MOUSE_MOVE_MED)
#define MOVE_RIGHT_MED MOVE_X(U_MOUSE_MOVE_MED)
#define U_MOUSE_SCROLL_MED 12
#define U_MOUSE_SCROLL_MIN 6
#define U_MOUSE_SCROLL_MAX 18

#undef SCROLL_UP
#undef SCROLL_DOWN
#undef SCROLL_LEFT
#undef SCROLL_RIGHT

#define SCROLL_UP_MAX MOVE_Y(U_MOUSE_SCROLL_MAX)
#define SCROLL_DOWN_MAX MOVE_Y(-U_MOUSE_SCROLL_MAX)
#define SCROLL_UP_MED MOVE_Y(U_MOUSE_SCROLL_MED)
#define SCROLL_DOWN_MED MOVE_Y(-U_MOUSE_SCROLL_MED)
#define SCROLL_UP_MIN MOVE_Y(U_MOUSE_SCROLL_MIN)
#define SCROLL_DOWN_MIN MOVE_Y(-U_MOUSE_SCROLL_MIN)

&mmv {
    acceleration-exponent = <1>;  // 1
    time-to-max-speed-ms = <0>; // 300
    delay-ms = <0>;
    trigger-period-ms = <8>;      // 16
};

&msc {
    acceleration-exponent = <1>;  // 0
    time-to-max-speed-ms = <0>;  // 300
    delay-ms = <0>;
    trigger-period-ms = <8>;      // 16
};

/ {
    normal_mmv {
        compatible = "zmk,input-behavior-listener";
        device = <&mmv>;
        layers = <5>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <7>;
        scale-divisor = <6>;
    };

    fast_mmv {
        compatible = "zmk,input-behavior-listener";
        device = <&mmv>;
        layers = <7>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <2>;
        scale-divisor = <1>;
    };

    fine_mmv {
        compatible = "zmk,input-behavior-listener";
        device = <&mmv>;
        layers = <6>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <3>;
        scale-divisor = <8>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp F1    &kp F2        &kp F3  &kp F4  &kp F5     &kp C_VOL_UP              &kp C_MUTE  &kp F6  &kp F7            &kp F8           &kp F9  &kp F10  &kp PSCRN
&kp GRAVE   &kp N1    &kp N2        &kp N3  &kp N4  &kp N5     &kp C_VOL_DN                                  &kp C_PLAY_PAUSE  &kp N6           &kp N7  &kp N8   &kp N9         &kp N0     &kp BACKSPACE
&kp TAB     &kp Q     &kp W         &kp E   &kp R   &kp T      &kp PG_UP                                     &kp EQUAL         &kp Y            &kp U   &kp I    &kp O          &kp P      &kp BSLH
&kp ESCAPE  &kp A     &kp S         &kp D   &kp F   &kp G      &kp PG_DN                                     &kp MINUS         &kp H            &kp J   &kp K    &kp L          &kp SEMI   &kp SQT
&kp LSHFT   &kp Z     &kp X         &kp C   &kp V   &kp B                                                                                       &kp N   &kp M    &kp COMMA      &kp DOT    &kp FSLH       &kp RIGHT_SHIFT
&kp LCTRL   &kp LCMD  &kp LEFT_ALT  &mo 3   &mo 6   &kp SPACE  &mo 2         &mo 5                   &mo 5   &mo 1             &kp ENTER        &mo 6   &mo 3    &kp RIGHT_ALT  &kp RMETA  &kp RCTRL
                                                               &kp CAPSLOCK  &kp LSHIFT                      &kp RGUI          &kp RIGHT_SHIFT
            >;
        };

        rightmod {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans    &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans    &trans         &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans    &trans         &trans     &kp DELETE  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &kp RALT  &kp RMETA      &kp RCTRL  &kp RSHIFT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans    &kp BACKSPACE  &trans     &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans         &trans     &trans      &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        leftmod {
            bindings = <
&trans  &trans      &trans     &trans     &trans        &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &kp P     &trans
&trans  &kp LSHIFT  &kp LCTRL  &kp LMETA  &kp LEFT_ALT  &trans  &trans                          &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&trans  &trans      &trans     &trans     &trans        &trans                                                  &trans  &trans  &trans  &trans    &trans  &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
                                                                &trans  &trans                  &trans  &trans
            >;
        };

        bt {
            bindings = <
&to 8       &trans        &trans        &trans        &trans        &trans          &trans          &trans  &trans  &trans  &trans  &trans       &trans  &trans
&bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL  &trans                          &trans  &trans  &trans       &trans  &trans  &trans      &trans
&trans      &sys_reset    &trans        &trans        &trans        &trans          &trans                          &trans  &trans  &trans       &trans  &trans  &sys_reset  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans                          &trans  &trans  &trans       &trans  &trans  &trans      &trans
&trans      &trans        &trans        &trans        &trans        &bootloader                                                     &bootloader  &trans  &trans  &trans      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans          &trans  &trans  &trans  &trans       &trans  &trans  &trans      &trans
                                                                                    &trans  &trans                  &trans  &trans
            >;
        };

        modmove {
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans    &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans    &trans    &trans     &trans     &trans            &kp MINUS
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                          &trans  &kp N6    &kp N7    &kp N8     &kp N9     &kp N0            &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &trans            &trans
&trans     &trans  &trans  &trans  &trans  &trans                                                    &trans    &kp EQUAL  &kp MINUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans    &trans    &trans     &trans     &trans            &trans
                                                   &trans  &trans                  &trans  &trans
            >;
        };

        mousedefault {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans  &trans          &trans  &trans  &trans  &trans              &trans                &trans            &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans                          &trans  &trans              &trans                &trans            &trans               &trans              &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans                          &trans  &trans              &trans                &trans            &trans               &msc SCROLL_UP_MED  &trans
&mo 7   &mo 7   &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans                          &trans  &mmv MOVE_LEFT_MED  &mmv MOVE_DOWN_MED    &mmv MOVE_UP_MED  &mmv MOVE_RIGHT_MED  &trans              &trans
&trans  &trans  &trans    &trans    &trans    &trans                                                              &msc SCROLL_DOWN_MED  &trans            &trans               &trans              &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans  &trans          &trans  &trans  &trans              &trans                &trans            &trans               &trans              &trans
                                                      &trans  &trans                  &trans  &trans
            >;
        };

        mouseslow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans                &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &msc SCROLL_UP_MIN  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &msc SCROLL_DOWN_MIN  &trans  &trans  &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans                &trans  &trans  &trans              &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        mousefast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans                &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &msc SCROLL_UP_MAX  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans                &trans  &trans  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &msc SCROLL_DOWN_MAX  &trans  &trans  &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans                &trans  &trans  &trans              &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        game_layer {
            bindings = <
&trans  &trans          &trans     &trans        &trans  &trans  &trans          &to 0  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE       &kp N1     &kp N2        &kp N3  &kp N4  &kp N5                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp ESCAPE      &kp Q      &kp W         &kp E   &kp R   &kp T                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp A      &kp S         &kp D   &kp F   &kp G                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LCTRL       &kp Z      &kp X         &kp C   &kp V                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &kp LMETA  &kp LEFT_ALT  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                                 &trans  &trans                 &trans  &trans
            >;
        };
    };
};
