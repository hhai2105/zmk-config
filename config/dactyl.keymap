#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  F1 |  F2 |  F3 |  F4 |  F5 | VOLUP |      |    | MUTE |  F6  |  F7 |  F8 |  F9 | F10  | PSCRN |
            // |  ~   |  1  |  2  |  3  |  4  |  5  | VOLDN |      |    |  -   |  6   |  7  |  8  |  9  |  0   | +     |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  | PgUp  |      |    |  {   |  Y   |  U  |  I  |  O  |  P   | \     |
            // | CAP  |  A  |  S  |  D  |  F  |  G  | PgDn  |      |    |  }   |  H   |  J  |  K  |  L  |  ;   | '     |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |       |      |    |      |  N   |  M  |  ,  |  .  |  /   | HOME  |
            // | L2   |  \  |  <- |  v  | BKSP| SHFT| ALT   | L1   |    |      |  M   |  ,  |  .  |  /  | ESC  | END |
            //                                      | CTRL  | META |    |    | ENT | RSE  | ALT |

            bindings = <
&kp ESC     &kp F1    &kp F2        &kp F3  &kp F4  &kp F5     &kp C_VOL_UP              &kp C_MUTE  &kp F6  &kp F7            &kp F8           &kp F9  &kp F10  &kp PSCRN
&kp GRAVE   &kp N1    &kp N2        &kp N3  &kp N4  &kp N5     &kp C_VOL_DN                                  &kp C_PLAY_PAUSE  &kp N6           &kp N7  &kp N8   &kp N9         &kp N0     &kp BACKSPACE
&kp TAB     &kp Q     &kp W         &kp E   &kp R   &kp T      &kp PG_UP                                     &kp EQUAL         &kp Y            &kp U   &kp I    &kp O          &kp P      &kp BSLH
&kp ESCAPE  &kp A     &kp S         &kp D   &kp F   &kp G      &kp PG_DN                                     &kp MINUS         &kp H            &kp J   &kp K    &kp L          &kp SEMI   &kp SQT
&kp LSHFT   &kp Z     &kp X         &kp C   &kp V   &kp B                                                                                       &kp N   &kp M    &kp COMMA      &kp DOT    &kp FSLH       &kp RIGHT_SHIFT
&kp LCTRL   &kp LCMD  &kp LEFT_ALT  &mo 5   &mo 3   &kp SPACE  &mo 2         &mo 6                   &mo 6   &mo 1             &kp ENTER        &mo 4   &mo 5    &kp RIGHT_ALT  &kp RMETA  &kp RCTRL
                                                               &kp CAPSLOCK  &kp LSHIFT                      &kp RGUI          &kp RIGHT_SHIFT
            >;
        };

        rightmod {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans    &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans    &trans     &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans    &trans     &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &kp RALT  &kp RMETA  &kp RCTRL  &kp RSHIFT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans    &trans     &trans     &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans     &trans     &trans      &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        leftmod {
            bindings = <
&trans  &trans      &trans     &trans     &trans        &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp LSHIFT  &kp LCTRL  &kp LMETA  &kp LEFT_ALT  &trans  &trans                          &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&trans  &trans      &trans     &trans     &trans        &trans                                                  &trans  &trans  &trans  &trans    &trans  &trans
&trans  &trans      &trans     &trans     &trans        &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
                                                                &trans  &trans                  &trans  &trans
            >;
        };

        modmove {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans         &trans     &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans         &trans     &trans        &trans            &trans             &kp MINUS
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans                          &trans  &trans         &kp EQUAL  &kp MINUS     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans                          &trans  &kp LEFT       &kp DOWN   &kp UP_ARROW  &kp RIGHT         &trans             &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans                                                         &trans     &trans        &trans            &trans             &trans     &trans
&trans  &trans  &kp N0  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &kp BACKSPACE  &trans     &trans        &trans            &trans             &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        numpadlayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        bt {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans       &trans          &trans  &trans  &trans  &trans  &trans       &trans  &trans
&bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans       &trans                          &trans  &trans  &trans       &trans  &trans     &trans  &trans
&trans      &reset        &soft_off     &trans        &trans        &trans       &trans                          &trans  &trans  &trans       &trans  &soft_off  &reset  &trans
&trans      &trans        &trans        &trans        &trans        &trans       &trans                          &trans  &trans  &trans       &trans  &trans     &trans  &trans
&trans      &trans        &trans        &trans        &trans        &bootloader                                                  &bootloader  &trans  &trans     &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans       &trans  &trans          &trans  &trans  &trans  &trans       &trans  &trans     &trans  &trans
                                                                                 &trans  &trans                  &trans  &trans
            >;
        };

        mousedefault {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans  &trans          &trans  &trans  &trans  &trans          &trans            &trans        &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans                          &trans  &trans          &trans            &trans        &trans           &trans          &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans                          &trans  &trans          &trans            &trans        &trans           &msc SCROLL_UP  &trans
&mo 8   &mo 7   &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans                          &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans          &trans
&trans  &trans  &trans    &trans    &trans    &trans                                                          &msc SCROLL_DOWN  &trans        &trans           &trans          &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans  &trans          &trans  &trans  &trans          &trans            &trans        &trans           &trans          &trans
                                                      &trans  &trans                  &trans  &trans
            >;
        };

        mouseslow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        mousefast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };
    };
};
