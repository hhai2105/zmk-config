#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  F1 |  F2 |  F3 |  F4 |  F5 | VOLUP |      |    | MUTE |  F6  |  F7 |  F8 |  F9 | F10  | PSCRN |
            // |  ~   |  1  |  2  |  3  |  4  |  5  | VOLDN |      |    |  -   |  6   |  7  |  8  |  9  |  0   | +     |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  | PgUp  |      |    |  {   |  Y   |  U  |  I  |  O  |  P   | \     |
            // | CAP  |  A  |  S  |  D  |  F  |  G  | PgDn  |      |    |  }   |  H   |  J  |  K  |  L  |  ;   | '     |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |       |      |    |      |  N   |  M  |  ,  |  .  |  /   | HOME  |
            // | L2   |  \  |  <- |  v  | BKSP| SHFT| ALT   | L1   |    |      |  M   |  ,  |  .  |  /  | ESC  | END |
            //                                      | CTRL  | META |    |    | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp F1  &kp F2        &kp F3    &kp F4  &kp F5     &kp C_VOL_UP             &kp C_MUTE  &kp F6     &kp F7     &kp F8           &kp F9  &kp F10   &kp PSCRN
&kp GRAVE  &kp N1  &kp N2        &kp N3    &kp N4  &kp N5     &kp C_VOL_DN                                    &kp MINUS  &kp N6           &kp N7  &kp N8    &kp N9     &kp N0    &kp EQUAL
&kp TAB    &kp Q   &kp W         &kp E     &kp R   &kp T      &kp PG_UP                                       &kp LBKT   &kp Y            &kp U   &kp I     &kp O      &kp P     &kp BSLH
&kp CLCK   &kp A   &kp S         &kp D     &kp F   &kp G      &kp PG_DN                                       &kp RBKT   &kp H            &kp J   &kp K     &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X         &kp C     &kp V   &kp B                                                                                  &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp HOME
&kp LCTRL  &mo 2   &kp UP_ARROW  &kp DOWN  &mo 1   &kp SPACE  &kp LALT      &kp LCTRL              &kp RCTRL  &kp RALT   &kp ENTER        &mo 1   &kp LEFT  &kp RIGHT  &mo 2     &kp END
                                                              &kp LSHIFT    &kp LGUI                          &kp RGUI   &kp RIGHT_SHIFT
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans         &trans    &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans         &trans    &trans        &trans     &trans  &kp MINUS
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans                          &trans  &trans         &trans    &trans        &trans     &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans                          &trans  &kp LEFT       &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans                                                         &trans    &trans        &trans     &trans  &trans     &trans
&trans  &trans  &kp N0  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &kp BACKSPACE  &trans    &trans        &trans     &trans  &trans
                                                &trans  &trans                  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans       &trans          &trans  &trans  &trans  &trans  &trans       &trans  &trans
&bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans       &trans                          &trans  &trans  &trans       &trans  &trans     &trans      &trans
&trans      &sys_reset    &soft_off     &trans        &trans        &trans       &trans                          &trans  &trans  &trans       &trans  &soft_off  &sys_reset  &trans
&trans      &trans        &trans        &trans        &trans        &trans       &trans                          &trans  &trans  &trans       &trans  &trans     &trans      &trans
&trans      &trans        &trans        &trans        &trans        &bootloader                                                  &bootloader  &trans  &trans     &trans      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans       &trans  &trans          &trans  &trans  &trans  &trans       &trans  &trans     &trans      &trans
                                                                                 &trans  &trans                  &trans  &trans
            >;
        };
    };
};
